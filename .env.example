# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=<generate-with: python3 -c "import secrets; print(secrets.token_urlsafe(50))">
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://hirecheck:hirecheck@localhost:5432/hirecheck

# Redis (production only; dev uses DB cache)
REDIS_URL=redis://127.0.0.1:6379/0

# AI API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# HMAC Secret (shared between extension and backend)
HMAC_SECRET_KEY=<generate-with: python3 -c "import secrets; print(secrets.token_hex(32))">

# Sentry
SENTRY_DSN=

# Rate Limiting
DAILY_ANALYSIS_LIMIT=5
