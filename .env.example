# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://hirecheck:hirecheck@localhost:5432/hirecheck

# Redis (production only; dev uses DB cache)
REDIS_URL=redis://127.0.0.1:6379/0

# AI API Keys
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# HMAC Secret (shared between extension and backend)
HMAC_SECRET_KEY=generate-a-64-char-random-hex-string

# Sentry
SENTRY_DSN=

# Rate Limiting
DAILY_ANALYSIS_LIMIT=5
